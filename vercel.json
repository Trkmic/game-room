{
    "version": 3,
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
            "distDir": "dist/sala-juegos/browser"
            }
        }
    ],
    "routes": [
        { "src": "/(.*)", "dest": "/index.html" }
    ]
}